# GEMINI_API_KEY: Required for live Gemini AI API calls (OCR, Voice parsing, Grounded AI Munim Chat).
# AI Studio automatically injects this at runtime from user secrets.
# If omitted or unavailable, AI Munim automatically falls back to deterministic Demo Mode providers.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DEMO_MODE: Set to "true" (default) to enable deterministic Demo providers, sample OTP (123456), and bundled demo bills/statements.
DEMO_MODE="true"

# SESSION_SECRET: Secret used to sign HTTP-only session tokens.
SESSION_SECRET="ai-munim-session-secret-change-in-production"

# OCR_PROVIDER: "gemini" | "demo" (automatically falls back to "demo" if GEMINI_API_KEY is not set)
OCR_PROVIDER="demo"

# SPEECH_PROVIDER: "browser" | "gemini" | "demo"
SPEECH_PROVIDER="demo"

# LLM_PROVIDER: "gemini" | "demo"
LLM_PROVIDER="demo"

# STORAGE_PROVIDER: "local" | "demo"
STORAGE_PROVIDER="demo"

# MESSAGING_PROVIDER: "draft_only"
MESSAGING_PROVIDER="draft_only"

